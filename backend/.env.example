# STEMWISE backend environment (spec §84). Copy to .env and fill real secrets.
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# When running via docker-compose, host is the mongo service name.
DATABASE_URL=mongodb://mongo:27017/stemwise

# CHANGE THESE in any non-local environment. Never commit real secrets.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
